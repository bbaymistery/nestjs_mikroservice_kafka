{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "node"
    ],
    "paths": {
      "@app/common": [
        "./libs/common/src"
      ],
      "@app/common/*": [
        "./libs/common/src/*"
      ],
      "@app/kafka": [
        "./libs/kafka/src"
      ],
      "@app/kafka/*": [
        "./libs/kafka/src/*"
      ],
      "y/database": [
        "./libs/database/src"
      ],
      "y/database/*": [
        "./libs/database/src/*"
      ],
      "@app/database": [
        "./libs/database/src"
      ],
      "@app/database/*": [
        "./libs/database/src/*"
      ]
    }
  },
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}